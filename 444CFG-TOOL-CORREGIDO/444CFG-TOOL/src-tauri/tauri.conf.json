{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "444CFG TOOL",
  "version": "1.0.0",
  "identifier": "gg.cfg444.tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "444CFG TOOL", "width": 1100, "height": 750, "minWidth": 900, "minHeight": 620, "decorations": false, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] } }
  }
}
